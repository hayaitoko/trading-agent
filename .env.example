# Copy to .env and fill in. .env is gitignored.

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-agent/0.1 by yourusername

# StockTwits (https://api.stocktwits.com/developers)
STOCKTWITS_ACCESS_TOKEN=

# Investopedia simulator (https://www.investopedia.com/simulator/)
INVESTOPEDIA_USERNAME=
INVESTOPEDIA_PASSWORD=

# SQLite path for post/signal/trade log
TRADING_AGENT_DB=./trading_agent.db
