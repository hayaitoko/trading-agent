# trading-agent Docker stack — environment variables
# Copy to .env and fill in the required values before running ./setup.sh

# ---------------------------------------------------------------------------
# Broker credentials (Alpaca)
# ---------------------------------------------------------------------------
# Sign up at https://alpaca.markets — paper account is free, data access is free.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# 1 = paper trading (safe default), 0 = live trading (REAL MONEY — be careful)
ALPACA_PAPER=1

# ---------------------------------------------------------------------------
# LLM routing (OpenRouter)
# ---------------------------------------------------------------------------
# Get a key at https://openrouter.ai — used for trader decision-making,
# manager agent, research, and reflection.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---------------------------------------------------------------------------
# Owner account
# ---------------------------------------------------------------------------
# The first user created in the app.  Log in with these credentials.
OWNER=admin
OWNER_PASSWORD=change_me_on_first_boot

# ---------------------------------------------------------------------------
# Embedding model (Ollama)
# ---------------------------------------------------------------------------
# Default embedding model the app uses (an OLLAMA tag). EMBED_DIM must match it.
# mxbai-embed-large (~670 MB, 1024-dim) — recommended for VPS / modern hardware.
# all-minilm        (~45 MB,  384-dim)  — fast + light, best for a Raspberry Pi 4B.
# nomic-embed-text  (~275 MB, 768-dim)  — middle ground.
EMBED_MODEL=mxbai-embed-large
EMBED_DIM=1024

# EMBED_MODELS: comma-separated list the embedder DOWNLOADS on first boot so the
# Settings-UI picker can switch between them live. Defaults to just EMBED_MODEL.
# e.g. EMBED_MODELS=mxbai-embed-large,all-minilm
EMBED_MODELS=mxbai-embed-large

# Base URL for the Ollama OpenAI-compatible embeddings endpoint (inside Docker network).
# Override this if you point at an EXTERNAL Ollama instance or a different provider.
EMBED_BASE_URL=http://embedder:11434/v1

# ---------------------------------------------------------------------------
# Vector store (Qdrant)
# ---------------------------------------------------------------------------
# URL of the Qdrant service (inside Docker network).
# Override to point at an external Qdrant cluster:  QDRANT_URL=http://my-qdrant:6333
QDRANT_URL=http://qdrant:6333

# "qdrant" (default, recommended) or "sqlite-vec" (single-file, no extra service)
VSTORE=qdrant

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
# Host port the app listens on (container port is always 8000).
PORT=8000

# ---------------------------------------------------------------------------
# App feature flags
# ---------------------------------------------------------------------------
# 1 = enable the market-hours scheduler (gates turns to US market hours + ET).
# Leave 0 during initial testing so trader turns fire any time of day.
TRADING_AGENT_SCHEDULER=1

# 1 = enable the dev-only /api/dev/fire-turn endpoint.  Set 0 in production.
TRADING_AGENT_DEV_TRIGGER=0

# Tutorial turns count override.  0 = use app default.
TRADING_AGENT_TUTORIAL_TURNS=0

# Emergency kill switch — set to any non-empty value to halt all trading.
# Unset or leave empty to allow trading.
TRADING_AGENT_KILL_SWITCH=

# ---------------------------------------------------------------------------
# TLS (optional, profile: tls)
# ---------------------------------------------------------------------------
# Only needed when running with --profile tls (Caddy reverse proxy).
# DOMAIN=trade.example.com
