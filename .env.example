# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Alpaca (US equities) ---
# Free paper-trading keys: https://alpaca.markets  (paper dashboard)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper account (safe sandbox), false = LIVE real-money trading
ALPACA_PAPER=true

# --- Crypto via ccxt (optional; public price data needs no keys) ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Risk kill switch (optional) ---
# Set to 1 to hard-block all trading regardless of config.
TRADING_AGENT_KILL_SWITCH=
